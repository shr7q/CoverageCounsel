# Copy this file to .env and fill in your real keys. Never commit .env itself.

# EMBED_PROVIDER: "ollama" (local, needs Ollama running), "sentence_transformers"
# (local, in-process, no server needed -- this is what production/CI uses,
# since it's free and needs no API key), or "openai" for the real
# text-embedding-3-small endpoint.
# LLM_PROVIDER: "ollama" (local) or "anthropic" for real Claude.
EMBED_PROVIDER=sentence_transformers
LLM_PROVIDER=anthropic

# Used for embeddings (text-embedding-3-small) when EMBED_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here

# Used for generation (Claude) when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# Postgres: users/roles/document metadata (RBAC) and the pgvector dense
# store. Matches docker-compose.yml -- run `docker compose up -d`.
DATABASE_URL=postgresql://rag:rag_local_dev@localhost:5432/healthcare_rag

# VECTOR_STORE=memory uses an in-memory numpy store instead (no Postgres
# needed) -- default is pgvector, the real vector store.
VECTOR_STORE=pgvector

# Observability. Free account at smith.langchain.com. Set
# LANGSMITH_TRACING=false to disable tracing without removing the key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=healthcare-rag
