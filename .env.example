# Copy this file to .env and fill in your real keys. Never commit .env itself.

# Set both to "ollama" to run fully local (no API keys needed, requires
# Ollama running locally with the models pulled). Set back to "openai" /
# "anthropic" to use the real hosted APIs.
EMBED_PROVIDER=openai
LLM_PROVIDER=anthropic

# Used for embeddings (text-embedding-3-small) when EMBED_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here

# Used for generation (Claude) when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# Postgres (Week 6 RBAC: users/roles/document metadata; Week 9: pgvector
# dense store). Matches docker-compose.yml -- run `docker compose up -d`.
DATABASE_URL=postgresql://rag:rag_local_dev@localhost:5432/healthcare_rag

# VECTOR_STORE=memory reproduces the original in-memory numpy store (no
# Postgres needed) -- default is pgvector, the real Week 9 vector store.
VECTOR_STORE=pgvector

# Observability (Week 8). Free account at smith.langchain.com. Set
# LANGSMITH_TRACING=false to disable tracing without removing the key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=healthcare-rag
